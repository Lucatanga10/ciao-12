# OJBS-UE-ANDROID — target configuration
#
# PROVENANCE RULES
#   Every build-dependent value below carries its provenance on its own line:
#     [kind | build | source | verified?]
#   kind is one of: file offset, RVA (module-relative), runtime VA (absolute).
#   An EMPTY string means UNSET. A real 0 is written as 0 and is never empty.
#   A value with an empty provenance line is a hypothesis, not a fact.
#
# Nothing in this file is filled in from memory or from "typical" values.
# Everything marked DERIVED-AT-RUNTIME is computed by `ojbs derive` against the
# live process and written back to config/derived.env with its confidence.

# --------------------------------------------------------------------------
# transport
# --------------------------------------------------------------------------
# adb   = scripts run on a host with the phone attached over USB debugging
# local = scripts run on the phone itself (Termux)
OJBS_TRANSPORT="adb"

# adb serial; empty = single attached device
OJBS_ADB_SERIAL=""

# su binary used on the device; empty = autodetect (su, /system/bin/su, ...)
OJBS_SU=""

# --------------------------------------------------------------------------
# target identity
# --------------------------------------------------------------------------
# [package name | unknown build | operator/autodetect | unverified]
# empty = autodetect: `ojbs setup` greps `pm list packages` for OJBS_PKG_HINT
OJBS_PACKAGE=""
OJBS_PKG_HINT="fortnite"

# process name if it differs from the package (UE games often use :GameProcess)
# empty = same as package
OJBS_PROCESS=""

# main engine module. empty = autodetect: the largest .so mapped out of the
# package's own lib directory in /proc/<pid>/maps
# [module name | unknown build | autodetect from maps | unverified]
UE_MODULE=""

# expected image span in bytes; empty = unset (0 would be a real, absurd size)
# filled by `ojbs status` and used afterwards as a build-change tripwire
UE_MODULE_SIZE=""

# build identity string; empty = unset. anything dumped under a different
# build id is treated as STALE and its features are gated at load time.
UE_BUILD_ID=""

# --------------------------------------------------------------------------
# engine globals — all DERIVED-AT-RUNTIME, all unset here
# --------------------------------------------------------------------------
# FNamePool block table. The scanner validates a candidate by decoding entry 0
# of block 0 and requiring it to be the string "None" — the engine's own
# invariant, not a pattern.
# [RVA | unset | derive | unverified]
UE_FNAMEPOOL_BLOCKS_RVA=""

# bits of an FName comparison index used as the in-block offset.
# 16 on stock UE4.23+ / UE5. Not build-dependent data: it is a compile-time
# engine constant, and the scanner retries 13..17 until block 0 decodes "None".
UE_FNAME_BLOCK_BITS="16"

# FUObjectArray (FChunkedFixedUObjectArray). Validated structurally:
# NumElements <= MaxElements, NumChunks <= MaxChunks, chunk 0 readable,
# object 0 carries a vtable pointer inside the engine module.
# [RVA | unset | derive | unverified]
UE_GOBJECTS_RVA=""

# bytes per FUObjectItem. empty = derive by testing 16/24/32 against
# InternalIndex continuity across sampled indices.
UE_FUOBJECTITEM_SIZE=""

# UWorld* static. Derived by locating the live UWorld through GObjects and then
# finding the module-resident pointer that holds it.
# [RVA | unset | derive | unverified]
UE_GWORLD_RVA=""

# --------------------------------------------------------------------------
# struct offsets — all DERIVED-AT-RUNTIME, all unset here
# --------------------------------------------------------------------------
# Set any of these by hand to override derivation. A hand-set value is tiered
# "operator" in the dump and is trusted without further validation.
#
# UObject
UE_OFF_UOBJECT_INDEX=""        # int32 InternalIndex
UE_OFF_UOBJECT_CLASS=""        # UClass* ClassPrivate
UE_OFF_UOBJECT_NAME=""         # FName NamePrivate (int32 ComparisonIndex first)
UE_OFF_UOBJECT_OUTER=""        # UObject* OuterPrivate
#
# UStruct
UE_OFF_USTRUCT_SUPER=""        # UStruct* SuperStruct
UE_OFF_USTRUCT_CHILDPROPS=""   # FField* ChildProperties (UE>=4.25)
UE_OFF_USTRUCT_CHILDREN=""     # UField* Children (UE<4.25 fallback)
UE_OFF_USTRUCT_SIZE=""         # int32 PropertiesSize
#
# FField / UField node
UE_OFF_FFIELD_NEXT=""          # FField* Next
UE_OFF_FFIELD_NAME=""          # FName NamePrivate
#
# FProperty
UE_OFF_FPROPERTY_OFFSET=""     # int32 Offset_Internal
UE_OFF_FPROPERTY_ELEMSIZE=""   # int32 ElementSize
#
# property subclasses — only needed for inline struct hops and Prop[i] hops
UE_OFF_FSTRUCTPROP_STRUCT=""   # UScriptStruct* Struct on a StructProperty
UE_OFF_FARRAYPROP_INNER=""     # FProperty* Inner on an ArrayProperty

# --------------------------------------------------------------------------
# scanner limits
# --------------------------------------------------------------------------
# scan only module-resident read/write ranges by default; set to 1 to include
# every rw- range in the process (slower, finds globals that moved to the heap)
UE_SCAN_ALL_RANGES="0"
UE_SCAN_STRIDE="8"
UE_SCAN_MAX_HITS="8"

# object sampling used by the derivation passes
UE_DERIVE_SAMPLES="64"
UE_DERIVE_MAX_FIELD_OFFSET="0x60"

# reflection dump bounds
UE_DUMP_MAX_CLASSES="0"        # 0 = no limit
UE_DUMP_MAX_PROPS="4096"
UE_DUMP_CLASS_FILTER=""        # substring match on "Package.Class"; empty = all

# --------------------------------------------------------------------------
# pointer plausibility
# --------------------------------------------------------------------------
# architecture bounds, not build data
UE_MIN_POINTER="0x10000"
UE_MAX_POINTER="0x7fffffffffff"
UE_MAX_ABS_FLOAT="1000000"

# --------------------------------------------------------------------------
# drivers and paths
# --------------------------------------------------------------------------
# frida   = inject the agent, full speed, needed for derive/dump
# shellmem = external reads through /proc/<pid>/mem, no injection, watch only
OJBS_DRIVER="frida"
OJBS_WATCH_DRIVER="shellmem"

# frida-inject binary on the device. empty = autodetect on PATH
OJBS_FRIDA_INJECT=""
# frida CLI on the host, used only when frida-inject is absent
OJBS_FRIDA_CLI="frida"
# frida-server listen address used by the CLI driver
OJBS_FRIDA_HOST="127.0.0.1"
OJBS_FRIDA_PORT="27042"

# where the injected agent writes. must be writable by the game's own uid,
# so it lives in the package's private directory.
OJBS_DEVICE_OUT="/data/data/__PKG__/files/ojbs"
# where the shell copies results to
OJBS_OUT_DIR="out"
# scratch for the assembled agent
OJBS_WORK_DIR="work"

# agent run budget
OJBS_DERIVE_TIMEOUT="120"
OJBS_DUMP_TIMEOUT="900"
OJBS_RUN_TIMEOUT="120"

# --------------------------------------------------------------------------
# watch
# --------------------------------------------------------------------------
OJBS_WATCH_PERIOD_MS="100"
OJBS_WATCH_DURATION_S="30"
OJBS_WATCHLIST="config/watchlist.json"

# this binary ships integrity checks of its own: an injected agent is the
# detectable path, external /proc/mem reads are not — keep OJBS_WATCH_DRIVER
# on shellmem unless you are on a throwaway account
