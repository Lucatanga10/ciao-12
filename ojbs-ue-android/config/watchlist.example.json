{
  "schema": 1,
  "note": "Every hop is a property NAME, resolved through the engine's own reflection data at run time. No numeric offset appears in this file. Copy to config/watchlist.json and edit.",
  "roots": {
    "gworld": "the UWorld* found by `ojbs derive`",
    "class:<Package.Class>": "first live, non-CDO instance of that class in GObjects"
  },
  "path_forms": {
    "Property": "follow a property by name on the current struct",
    "Property[i]": "index a TArray property; validated as {Data,Num,Max} before use",
    "*": "dereference the current pointer without advancing a property"
  },
  "entries": [
