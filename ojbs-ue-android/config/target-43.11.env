# OJBS-UE-ANDROID — target configuration per 43.11
# Copia questo file come config/target.env prima di lanciare

# --------------------------------------------------------------------------
# transport: local = direttamente da Termux sul telefono
# --------------------------------------------------------------------------
OJBS_TRANSPORT="local"
OJBS_ADB_SERIAL=""
OJBS_SU=""

# --------------------------------------------------------------------------
# target identity
# --------------------------------------------------------------------------
OJBS_PACKAGE=""
OJBS_PKG_HINT="fortnite"
OJBS_PROCESS=""
UE_MODULE=""
UE_MODULE_SIZE=""
UE_BUILD_ID=""

# --------------------------------------------------------------------------
# engine globals — tutti DERIVED-AT-RUNTIME, tutti vuoti qui
# --------------------------------------------------------------------------
UE_FNAMEPOOL_BLOCKS_RVA=""
UE_FNAME_BLOCK_BITS="16"
UE_GOBJECTS_RVA=""
UE_FUOBJECTITEM_SIZE=""
UE_GWORLD_RVA=""

# --------------------------------------------------------------------------
# struct offsets — tutti DERIVED-AT-RUNTIME
# --------------------------------------------------------------------------
UE_OFF_UOBJECT_INDEX=""
UE_OFF_UOBJECT_CLASS=""
UE_OFF_UOBJECT_NAME=""
UE_OFF_UOBJECT_OUTER=""
UE_OFF_USTRUCT_SUPER=""
UE_OFF_USTRUCT_CHILDPROPS=""
UE_OFF_USTRUCT_CHILDREN=""
UE_OFF_USTRUCT_SIZE=""
UE_OFF_FFIELD_NEXT=""
UE_OFF_FFIELD_NAME=""
UE_OFF_FPROPERTY_OFFSET=""
UE_OFF_FPROPERTY_ELEMSIZE=""
UE_OFF_FSTRUCTPROP_STRUCT=""
UE_OFF_FARRAYPROP_INNER=""

# --------------------------------------------------------------------------
# scanner limits
# --------------------------------------------------------------------------
UE_SCAN_ALL_RANGES="0"
UE_SCAN_STRIDE="8"
UE_SCAN_MAX_HITS="8"
UE_DERIVE_SAMPLES="64"
UE_DERIVE_MAX_FIELD_OFFSET="0x60"
UE_DUMP_MAX_CLASSES="0"
UE_DUMP_MAX_PROPS="4096"
UE_DUMP_CLASS_FILTER=""

# --------------------------------------------------------------------------
# pointer plausibility
# --------------------------------------------------------------------------
UE_MIN_POINTER="0x10000"
UE_MAX_POINTER="0x7fffffffffff"
UE_MAX_ABS_FLOAT="1000000"

# --------------------------------------------------------------------------
# drivers
# --------------------------------------------------------------------------
OJBS_DRIVER="frida"
OJBS_WATCH_DRIVER="shellmem"
OJBS_FRIDA_INJECT=""
OJBS_FRIDA_CLI="frida"
OJBS_FRIDA_HOST="127.0.0.1"
OJBS_FRIDA_PORT="27042"
OJBS_DEVICE_OUT="/data/data/__PKG__/files/ojbs"
OJBS_OUT_DIR="out"
OJBS_WORK_DIR="work"
OJBS_DERIVE_TIMEOUT="120"
OJBS_DUMP_TIMEOUT="900"
OJBS_RUN_TIMEOUT="120"

# --------------------------------------------------------------------------
# watch
# --------------------------------------------------------------------------
OJBS_WATCH_PERIOD_MS="100"
OJBS_WATCH_DURATION_S="30"
OJBS_WATCHLIST="config/watchlist.json"
